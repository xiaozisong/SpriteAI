# ==== 运行时环境 ====
# PostgreSQL + pgvector（业务 / 向量 / LangGraph checkpoint）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/boomcat

# Redis（会话缓存 / 流式扇出 / Redis Streams 任务队列）
REDIS_URL=redis://localhost:6379/0

# ==== LLM ====
OPENAI_API_KEY=sk-ctY02YGMLmMaIINOWlEW4Hz7X0zyGqWkahbrnpg9lPJrS822
OPENAI_BASE_URL=https://88.api456.me/v1
DEFAULT_MODEL=glm-5.2

# Embedding（维度必须与 EMBEDDING_MODEL 输出一致）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ==== 可观测 ====
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=boomcat-agent

# ==== 安全 ====
AUTH_SECRET=change-me
